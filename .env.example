# Comma-separated origins allowed to call the VaxiCare API.
# Add the deployed frontend URL in Render after frontend deployment.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Backend-only Supabase credentials. Keep the service role key out of the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Four unused email addresses you control, separated by commas.
DEMO_ASHA_EMAILS=asha1@example.com,asha2@example.com,asha3@example.com,asha4@example.com
VAXI_API_BASE_URL=http://127.0.0.1:8000
